VITE_APPLICATION_STUDIO_URL=/applications/studio

# The preview keeps the deterministic local runtime by default. Switch to
# `http` only after a backend implements the normalized SSE contract described
# in docs/runtime-integration.md. Never place model or backend secrets here.
VITE_RUNTIME_MODE=mock
VITE_RUNTIME_BASE_URL=/api
VITE_RUNTIME_RUN_PATH=/v1/runtime/runs/stream
VITE_RUNTIME_CANCEL_PATH=/v1/runtime/runs/:runId/cancel
VITE_RUNTIME_RESUME_PATH=/v1/runtime/runs/:runId/resume
