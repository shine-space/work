VITE_APPLICATION_STUDIO_URL=/applications/studio

# The preview keeps the deterministic local runtime by default.
# - `argus` uses the existing Argus login token, binding list and formal
#   Application Command endpoint. It currently supports one digital employee
#   and a non-streaming response.
# - `http` requires the normalized SSE contract in docs/runtime-integration.md.
# Never place model or backend secrets here.
VITE_RUNTIME_MODE=argus
VITE_RUNTIME_BASE_URL=/api
VITE_ARGUS_WORKSPACE_ID=ws_argus_default
VITE_API_PROXY_TARGET=http://127.0.0.1:8888
VITE_RUNTIME_RUN_PATH=/v1/runtime/runs/stream
VITE_RUNTIME_CANCEL_PATH=/v1/runtime/runs/:runId/cancel
VITE_RUNTIME_RESUME_PATH=/v1/runtime/runs/:runId/resume
